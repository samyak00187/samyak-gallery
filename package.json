{
  "name": "samyak-gallery",
  "version": "1.0.0",
  "description": "Samyak - 3D scroll photo gallery",
  "author": "Samyak Jain",
  "main": "main.js",
  "scripts": {
    "prepare-assets": "node copy.js",
    "start": "npm run prepare-assets && electron .",
    "dist": "npm run prepare-assets && electron-builder --win portable"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.samyak.gallery",
    "productName": "Samyak",
    "files": [
      "main.js",
      "index.html",
      "three.min.js"
    ],
    "win": {
      "target": "portable"
    }
  }
}
